{
  "name": "@rs-inventory/desktop-electron",
  "version": "1.0.0",
  "description": "Electron main process and preload script for RS Inventory",
  "author": "RS ORANGE TECH PVT LTD",
  "private": true,
  "main": "./dist-electron/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node22 --outfile=dist-electron/main.cjs --external:electron && node scripts/copy-prisma.js",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build": "npm run build:preload && npm run build:main",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "build:win": "electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rs-inventory/business": "*",
    "@rs-inventory/database": "*",
    "@rs-inventory/types": "*",
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "electron": "34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.rsinventory.solo",
    "productName": "RS Inventory",
    "electronVersion": "34.3.0",
    "npmRebuild": false,
    "includeSubNodeModules": false,
    "asar": true,
    "asarUnpack": [
      "dist-electron/query_engine-windows.dll.node"
    ],
    "extraResources": [
      {
        "from": "../../node_modules/.prisma/client/query_engine-windows.dll.node",
        "to": "query_engine-windows.dll.node"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

