// RS Inventory - Solo Database Schema
// Provider: SQLite (Easily swappable with PostgreSQL in RS Inventory - LAN)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Companies
model Company {
  id                    String    @id @default(uuid())
  name                  String    @map("name")
  businessName          String    @default("") @map("business_name")
  businessType          String?   @map("business_type")
  ownerName             String?   @map("owner_name")
  mobile                String?
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String    @default("India")
  gstRegistered         Boolean   @default(false) @map("gst_registered")
  gstin                 String?   @unique
  pan                   String?
  taxType               String    @default("GST_REGISTERED") @map("tax_type")
  invoicePrefix         String    @default("INV") @map("invoice_prefix")
  startingInvoiceNumber Int       @default(1) @map("starting_invoice_number")
  financialYearStart    DateTime? @map("financial_year_start")
  financialYearEnd      DateTime? @map("financial_year_end")
  logoPath              String?   @map("logo_path")
  currency              String    @default("INR")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users                 User[]
  categories            Category[]
  units                 Unit[]
  brands                Brand[]
  products              Product[]
  customers             Customer[]
  suppliers             Supplier[]
  purchases             Purchase[]
  salesInvoices         SalesInvoice[]
  purchaseReturns       PurchaseReturn[]
  salesReturns          SalesReturn[]
  paymentsMade          PaymentMade[]
  customerLedgers       CustomerLedger[]
  supplierLedgers       SupplierLedger[]
  auditLogs             AuditLog[]
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  stockAdjustments      StockAdjustment[]
  stocktakes            Stocktake[]
  stockTransfers        StockTransfer[]
  inventoryLocations    InventoryLocation[]
  settings              Setting[]
  salesPayments         SalesPayment[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  cashRegisters         CashRegister[]
  cashRegisterSessions  CashRegisterSession[]
  cashMovements         CashMovement[]
  dayEndClosings        DayEndClosing[]

  @@map("companies")
}

// 2. Users
model User {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  username            String    @unique
  passwordHash        String    @map("password_hash")
  name                String
  email               String?
  mobile              String?
  roleId              String?   @map("role_id")
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  auditLogs           AuditLog[]

  @@map("users")
}

// 3. Categories
model Category {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@map("categories")
}

// 4. Units
model Unit {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  name          String
  shortCode     String    @map("short_code")
  allowDecimals Boolean   @default(false) @map("allow_decimals")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([companyId, shortCode])
  @@map("units")
}

// 4b. Brands
model Brand {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@map("brands")
}

// 5. Products
model Product {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  categoryId       String?   @map("category_id")
  brandId          String?   @map("brand_id")
  unitId           String?   @map("unit_id")
  name             String
  shortName        String?   @map("short_name")
  description      String?
  sku              String?
  barcode          String?
  hsnCode          String?   @map("hsn_code")
  productType      String    @default("PHYSICAL") @map("product_type") // PHYSICAL, SERVICE, NON_STOCK
  purchasePrice    Float     @default(0.0) @map("purchase_price")
  sellingPrice     Float     @default(0.0) @map("selling_price")
  mrp              Float     @default(0.0) @map("mrp")
  taxRate          Float     @default(0.0) @map("tax_rate")
  minimumStock     Float     @default(0.0) @map("minimum_stock")
  maximumStock     Float?    @map("maximum_stock")
  openingStock     Float     @default(0.0) @map("opening_stock")
  openingStockRate Float     @default(0.0) @map("opening_stock_rate")
  currentStock     Float     @default(0.0) @map("current_stock")
  trackStock       Boolean   @default(true) @map("track_stock")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit                 Unit?                 @relation(fields: [unitId], references: [id], onDelete: SetNull)
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  stockAdjustmentItems StockAdjustmentItem[]
  stocktakeItems       StocktakeItem[]
  stockTransferItems   StockTransferItem[]
  purchaseItems        PurchaseItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  priceHistory         ProductPriceHistory[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, isActive])
  @@map("products")
}

// 5b. Product Price History
model ProductPriceHistory {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  oldPurchasePrice Float?   @map("old_purchase_price")
  newPurchasePrice Float    @map("new_purchase_price")
  oldSellingPrice  Float?   @map("old_selling_price")
  newSellingPrice  Float    @map("new_selling_price")
  oldMrp           Float?   @map("old_mrp")
  newMrp           Float    @map("new_mrp")
  oldTaxRate       Float?   @map("old_tax_rate")
  newTaxRate       Float    @map("new_tax_rate")
  changedBy        String?  @map("changed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_price_history")
}

// 5c. Storage Locations
model InventoryLocation {
  id                    String            @id @default(uuid())
  companyId             String            @map("company_id")
  name                  String
  code                  String
  description           String?
  locationType          String            @default("STORE") @map("location_type") // STORE, WAREHOUSE, BACK_ROOM, DISPLAY
  isDefault             Boolean           @default(false) @map("is_default")
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  stockAdjustments      StockAdjustment[]
  stocktakes            Stocktake[]
  transfersFrom         StockTransfer[]   @relation("TransferSource")
  transfersTo           StockTransfer[]   @relation("TransferDestination")
  purchases             Purchase[]
  purchaseReturns       PurchaseReturn[]
  salesInvoices         SalesInvoice[]
  salesReturns          SalesReturn[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("inventory_locations")
}

// 6. Stock Movements (Authoritative Ledger)
model StockMovement {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  productId       String            @map("product_id")
  locationId      String            @map("location_id")
  movementType    String            @map("movement_type") // OPENING_STOCK, PURCHASE_RECEIPT, SALE, SALES_RETURN, PURCHASE_RETURN, ADJUSTMENT_IN, ADJUSTMENT_OUT, TRANSFER_IN, TRANSFER_OUT, STOCKTAKE_CORRECTION
  quantity        Float             // Signed quantity: + = increase, - = decrease
  unitCost        Float             @default(0.0) @map("unit_cost")
  referenceType   String?           @map("reference_type") // ADJUSTMENT, STOCKTAKE, TRANSFER, PURCHASE, SALE, OPENING
  referenceId     String?           @map("reference_id")
  referenceNumber String?           @map("reference_number")
  movementDate    DateTime          @default(now()) @map("movement_date")
  notes           String?
  createdBy       String?           @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([companyId, productId])
  @@index([companyId, locationId])
  @@index([companyId, movementDate])
  @@index([companyId, movementType])
  @@map("stock_movements")
}

// 6b. Stock Balances (Derived Operational Projections)
model StockBalance {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  productId   String            @map("product_id")
  locationId  String            @map("location_id")
  quantity    Float             @default(0.0)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location    InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([companyId, productId, locationId])
  @@index([companyId, locationId])
  @@map("stock_balances")
}

// 6c. Stock Adjustments
model StockAdjustment {
  id               String                @id @default(uuid())
  companyId        String                @map("company_id")
  adjustmentNumber String                @map("adjustment_number")
  locationId       String                @map("location_id")
  adjustmentType   String                @map("adjustment_type") // INCREASE, DECREASE
  reason           String
  status           String                @default("POSTED") // DRAFT, POSTED, CANCELLED
  notes            String?
  createdBy        String?               @map("created_by")
  approvedBy       String?               @map("approved_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location         InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items            StockAdjustmentItem[]

  @@unique([companyId, adjustmentNumber])
  @@index([companyId, createdAt])
  @@map("stock_adjustments")
}

// 6d. Stock Adjustment Items
model StockAdjustmentItem {
  id                 String          @id @default(uuid())
  adjustmentId       String          @map("adjustment_id")
  productId          String          @map("product_id")
  systemQuantity     Float           @map("system_quantity")
  countedQuantity    Float?          @map("counted_quantity")
  differenceQuantity Float           @map("difference_quantity")
  unitCost           Float           @default(0.0) @map("unit_cost")
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  adjustment         StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_adjustment_items")
}

// 6e. Physical Stocktake Sessions
model Stocktake {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  stocktakeNumber String            @map("stocktake_number")
  locationId      String            @map("location_id")
  status          String            @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdBy       String?           @map("created_by")
  completedBy     String?           @map("completed_by")
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items           StocktakeItem[]

  @@unique([companyId, stocktakeNumber])
  @@index([companyId, status])
  @@map("stocktakes")
}

// 6f. Stocktake Items
model StocktakeItem {
  id                 String    @id @default(uuid())
  stocktakeId        String    @map("stocktake_id")
  productId          String    @map("product_id")
  systemQuantity     Float     @map("system_quantity")
  countedQuantity    Float?    @map("counted_quantity")
  differenceQuantity Float     @default(0.0) @map("difference_quantity")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  stocktake          Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stocktake_items")
}

// 6g. Stock Transfers
model StockTransfer {
  id                    String              @id @default(uuid())
  companyId             String              @map("company_id")
  transferNumber        String              @map("transfer_number")
  sourceLocationId      String              @map("source_location_id")
  destinationLocationId String              @map("destination_location_id")
  status                String              @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  notes                 String?
  createdBy             String?             @map("created_by")
  completedBy           String?             @map("completed_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  completedAt           DateTime?           @map("completed_at")

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceLocation        InventoryLocation   @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   InventoryLocation   @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items                 StockTransferItem[]

  @@unique([companyId, transferNumber])
  @@index([companyId, createdAt])
  @@map("stock_transfers")
}

// 6h. Stock Transfer Items
model StockTransferItem {
  id          String        @id @default(uuid())
  transferId  String        @map("transfer_id")
  productId   String        @map("product_id")
  quantity    Float
  unitCost    Float         @default(0.0) @map("unit_cost")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("stock_transfer_items")
}

// 7. Purchases
model Purchase {
  id                    String            @id @default(uuid())
  companyId             String            @map("company_id")
  supplierId            String            @map("supplier_id")
  purchaseNumber        String            @map("purchase_number")
  supplierInvoiceNumber String?           @map("supplier_invoice_number")
  purchaseDate          DateTime          @default(now()) @map("purchase_date")
  dueDate               DateTime?         @map("due_date")
  locationId            String?           @map("location_id")
  status                String            @default("DRAFT") @map("status") // DRAFT, POSTED, CANCELLED
  subtotal              Float             @default(0.0) @map("subtotal")
  lineDiscountTotal     Float             @default(0.0) @map("line_discount_total")
  invoiceDiscount       Float             @default(0.0) @map("invoice_discount")
  taxableAmount         Float             @default(0.0) @map("taxable_amount")
  cgstAmount            Float             @default(0.0) @map("cgst_amount")
  sgstAmount            Float             @default(0.0) @map("sgst_amount")
  igstAmount            Float             @default(0.0) @map("igst_amount")
  cessAmount            Float             @default(0.0) @map("cess_amount")
  otherTaxAmount        Float             @default(0.0) @map("other_tax_amount")
  additionalCharges     Float             @default(0.0) @map("additional_charges")
  roundOff              Float             @default(0.0) @map("round_off")
  grandTotal            Float             @default(0.0) @map("grand_total")
  amountPaid            Float             @default(0.0) @map("amount_paid")
  amountReturned        Float             @default(0.0) @map("amount_returned")
  paymentStatus         String            @default("UNPAID") @map("payment_status") // UNPAID, PARTIALLY_PAID, PAID, OVERPAID
  notes                 String?
  internalReference     String?           @map("internal_reference")
  createdBy             String?           @map("created_by")
  updatedBy             String?           @map("updated_by")
  postedBy              String?           @map("posted_by")
  postedAt              DateTime?         @map("posted_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier              Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location              InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items                 PurchaseItem[]
  purchaseReturns       PurchaseReturn[]
  payments              PaymentMade[]

  @@unique([companyId, purchaseNumber])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseDate])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@map("purchases")
}

// 8. Purchase Items
model PurchaseItem {
  id                  String               @id @default(uuid())
  purchaseId          String               @map("purchase_id")
  productId           String               @map("product_id")
  productNameSnapshot String               @default("") @map("product_name_snapshot")
  skuSnapshot         String?              @map("sku_snapshot")
  barcodeSnapshot     String?              @map("barcode_snapshot")
  unitNameSnapshot    String?              @map("unit_name_snapshot")
  quantity            Float                @default(1.0)
  freeQuantity        Float                @default(0.0) @map("free_quantity")
  purchaseRate        Float                @default(0.0) @map("purchase_rate")
  discountPercentage  Float                @default(0.0) @map("discount_percentage")
  discountAmount      Float                @default(0.0) @map("discount_amount")
  taxableAmount       Float                @default(0.0) @map("taxable_amount")
  taxRate             Float                @default(0.0) @map("tax_rate")
  cgstRate            Float                @default(0.0) @map("cgst_rate")
  sgstRate            Float                @default(0.0) @map("sgst_rate")
  igstRate            Float                @default(0.0) @map("igst_rate")
  cessRate            Float                @default(0.0) @map("cess_rate")
  cgstAmount          Float                @default(0.0) @map("cgst_amount")
  sgstAmount          Float                @default(0.0) @map("sgst_amount")
  igstAmount          Float                @default(0.0) @map("igst_amount")
  cessAmount          Float                @default(0.0) @map("cess_amount")
  taxAmount           Float                @default(0.0) @map("tax_amount")
  lineTotal           Float                @default(0.0) @map("line_total")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  purchase            Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems         PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// 9. Sales Invoices
model SalesInvoice {
  id                       String             @id @default(uuid())
  companyId                String             @map("company_id")
  customerId               String?            @map("customer_id")
  invoiceNumber            String             @map("invoice_number")
  invoiceType              String             @default("RETAIL") @map("invoice_type") // RETAIL, TAX_INVOICE, CREDIT_SALE
  invoiceDate              DateTime           @default(now()) @map("invoice_date")
  dueDate                  DateTime?          @map("due_date")
  locationId               String?            @map("location_id")
  status                   String             @default("DRAFT") @map("status") // DRAFT, POSTED, CANCELLED
  // Customer snapshots (preserved for history)
  customerNameSnapshot     String?            @map("customer_name_snapshot")
  customerPhoneSnapshot    String?            @map("customer_phone_snapshot")
  customerAddressSnapshot  String?            @map("customer_address_snapshot")
  customerGstinSnapshot    String?            @map("customer_gstin_snapshot")
  // Financial fields
  subtotal                 Float              @default(0.0) @map("subtotal")
  lineDiscountTotal        Float              @default(0.0) @map("line_discount_total")
  invoiceDiscount          Float              @default(0.0) @map("invoice_discount")
  taxableAmount            Float              @default(0.0) @map("taxable_amount")
  cgstAmount               Float              @default(0.0) @map("cgst_amount")
  sgstAmount               Float              @default(0.0) @map("sgst_amount")
  igstAmount               Float              @default(0.0) @map("igst_amount")
  cessAmount               Float              @default(0.0) @map("cess_amount")
  otherTaxAmount           Float              @default(0.0) @map("other_tax_amount")
  additionalCharges        Float              @default(0.0) @map("additional_charges")
  roundOff                 Float              @default(0.0) @map("round_off")
  grandTotal               Float              @default(0.0) @map("grand_total")
  amountPaid               Float              @default(0.0) @map("amount_paid")
  amountReturned           Float              @default(0.0) @map("amount_returned")
  paymentStatus            String             @default("UNPAID") @map("payment_status") // UNPAID, PARTIALLY_PAID, PAID
  notes                    String?
  createdBy                String?            @map("created_by")
  updatedBy                String?            @map("updated_by")
  postedBy                 String?            @map("posted_by")
  postedAt                 DateTime?          @map("posted_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  company                  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                 Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location                 InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items                    SalesInvoiceItem[]
  salesPayments            SalesPayment[]
  salesReturns             SalesReturn[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, customerId])
  @@index([companyId, invoiceDate])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@map("sales_invoices")
}

// 10. Sales Invoice Items
model SalesInvoiceItem {
  id                     String       @id @default(uuid())
  companyId              String       @map("company_id")
  salesInvoiceId         String       @map("sales_invoice_id")
  productId              String       @map("product_id")
  // Historical snapshots
  productNameSnapshot    String       @default("") @map("product_name_snapshot")
  skuSnapshot            String?      @map("sku_snapshot")
  barcodeSnapshot        String?      @map("barcode_snapshot")
  unitNameSnapshot       String?      @map("unit_name_snapshot")
  hsnCodeSnapshot        String?      @map("hsn_code_snapshot")
  // Pricing
  quantity               Float        @default(1.0)
  sellingRate            Float        @default(0.0) @map("selling_rate")
  discountPercentage     Float        @default(0.0) @map("discount_percentage")
  discountAmount         Float        @default(0.0) @map("discount_amount")
  taxableAmount          Float        @default(0.0) @map("taxable_amount")
  taxRate                Float        @default(0.0) @map("tax_rate")
  cgstRate               Float        @default(0.0) @map("cgst_rate")
  sgstRate               Float        @default(0.0) @map("sgst_rate")
  igstRate               Float        @default(0.0) @map("igst_rate")
  cessRate               Float        @default(0.0) @map("cess_rate")
  cgstAmount             Float        @default(0.0) @map("cgst_amount")
  sgstAmount             Float        @default(0.0) @map("sgst_amount")
  igstAmount             Float        @default(0.0) @map("igst_amount")
  cessAmount             Float        @default(0.0) @map("cess_amount")
  taxAmount              Float        @default(0.0) @map("tax_amount")
  lineTotal              Float        @default(0.0) @map("line_total")
  unitCostSnapshot       Float        @default(0.0) @map("unit_cost_snapshot")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  salesInvoice           SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  product                Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesReturnItems       SalesReturnItem[]

  @@index([salesInvoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

// 11. Sales Returns
model SalesReturn {
  id                      String              @id @default(uuid())
  companyId               String              @map("company_id")
  returnNumber            String              @map("return_number")
  originalSalesInvoiceId  String              @map("original_sales_invoice_id")
  customerId              String?             @map("customer_id")
  returnDate              DateTime            @default(now()) @map("return_date")
  locationId              String?             @map("location_id")
  status                  String              @default("POSTED") @map("status") // POSTED, CANCELLED
  subtotal                Float               @default(0.0) @map("subtotal")
  discountAmount          Float               @default(0.0) @map("discount_amount")
  taxableAmount           Float               @default(0.0) @map("taxable_amount")
  cgstAmount              Float               @default(0.0) @map("cgst_amount")
  sgstAmount              Float               @default(0.0) @map("sgst_amount")
  igstAmount              Float               @default(0.0) @map("igst_amount")
  cessAmount              Float               @default(0.0) @map("cess_amount")
  otherTaxAmount          Float               @default(0.0) @map("other_tax_amount")
  grandTotal              Float               @default(0.0) @map("grand_total")
  refundAmount            Float               @default(0.0) @map("refund_amount")
  creditAmount            Float               @default(0.0) @map("credit_amount")
  reason                  String?
  notes                   String?
  createdBy               String?             @map("created_by")
  approvedBy              String?             @map("approved_by")
  postedBy                String?             @map("posted_by")
  postedAt                DateTime?           @map("posted_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  company                 Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originalSalesInvoice    SalesInvoice        @relation(fields: [originalSalesInvoiceId], references: [id], onDelete: Restrict)
  customer                Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  location                InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items                   SalesReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, originalSalesInvoiceId])
  @@index([companyId, returnDate])
  @@index([companyId, status])
  @@map("sales_returns")
}

// 12. Sales Return Items
model SalesReturnItem {
  id                          String           @id @default(uuid())
  companyId                   String           @map("company_id")
  salesReturnId               String           @map("sales_return_id")
  originalSalesInvoiceItemId  String?          @map("original_sales_invoice_item_id")
  productId                   String           @map("product_id")
  productNameSnapshot         String           @default("") @map("product_name_snapshot")
  quantity                    Float            @default(1.0)
  returnRate                  Float            @default(0.0) @map("return_rate")
  discountAmount              Float            @default(0.0) @map("discount_amount")
  taxRate                     Float            @default(0.0) @map("tax_rate")
  taxAmount                   Float            @default(0.0) @map("tax_amount")
  lineTotal                   Float            @default(0.0) @map("line_total")
  restockCondition            String           @default("RESELLABLE") @map("restock_condition") // RESELLABLE, DAMAGED, DEFECTIVE, EXPIRED, REQUIRES_INSPECTION
  reason                      String?
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  salesReturn                 SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  originalSalesInvoiceItem    SalesInvoiceItem? @relation(fields: [originalSalesInvoiceItemId], references: [id], onDelete: SetNull)
  product                     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([productId])
  @@map("sales_return_items")
}

// 13. Purchase Returns
model PurchaseReturn {
  id                 String               @id @default(uuid())
  companyId          String               @map("company_id")
  supplierId         String?              @map("supplier_id")
  purchaseId         String               @map("purchase_id")
  returnNumber       String               @map("return_number")
  returnDate         DateTime             @default(now()) @map("return_date")
  locationId         String?              @map("location_id")
  status             String               @default("POSTED") @map("status") // DRAFT, POSTED, CANCELLED
  subtotal           Float                @default(0.0) @map("subtotal")
  discountAmount     Float                @default(0.0) @map("discount_amount")
  taxableAmount      Float                @default(0.0) @map("taxable_amount")
  cgstAmount         Float                @default(0.0) @map("cgst_amount")
  sgstAmount         Float                @default(0.0) @map("sgst_amount")
  igstAmount         Float                @default(0.0) @map("igst_amount")
  cessAmount         Float                @default(0.0) @map("cess_amount")
  otherTaxAmount     Float                @default(0.0) @map("other_tax_amount")
  grandTotal         Float                @default(0.0) @map("grand_total")
  reason             String?
  notes              String?
  createdBy          String?              @map("created_by")
  approvedBy         String?              @map("approved_by")
  postedBy           String?              @map("posted_by")
  postedAt           DateTime?            @map("posted_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier           Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase           Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  location           InventoryLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items              PurchaseReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, purchaseId])
  @@index([companyId, returnDate])
  @@map("purchase_returns")
}

// 14. Purchase Return Items
model PurchaseReturnItem {
  id                  String         @id @default(uuid())
  purchaseReturnId    String         @map("purchase_return_id")
  purchaseItemId      String?        @map("purchase_item_id")
  productId           String         @map("product_id")
  productNameSnapshot String         @default("") @map("product_name_snapshot")
  quantity            Float          @default(1.0)
  returnRate          Float          @default(0.0) @map("return_rate")
  discountAmount      Float          @default(0.0) @map("discount_amount")
  taxRate             Float          @default(0.0) @map("tax_rate")
  taxAmount           Float          @default(0.0) @map("tax_amount")
  lineTotal           Float          @default(0.0) @map("line_total")
  reason              String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  purchaseReturn      PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem        PurchaseItem?  @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

// 15. Customers
model Customer {
  id                   String            @id @default(uuid())
  companyId            String            @map("company_id")
  customerCode         String            @default("") @map("customer_code")
  name                 String
  contactPerson        String?           @map("contact_person")
  phone                String?
  alternatePhone       String?           @map("alternate_phone")
  email                String?
  customerType         String            @default("INDIVIDUAL") @map("customer_type") // INDIVIDUAL, BUSINESS
  addressLine1         String?           @map("address_line_1")
  addressLine2         String?           @map("address_line_2")
  city                 String?
  state                String?
  pinCode              String?           @map("pin_code")
  country              String            @default("India")
  gstin                String?
  registrationType     String?           @map("registration_type") // REGULAR, COMPOSITION, UNREGISTERED, CONSUMER
  openingBalance       Float             @default(0.0) @map("opening_balance")
  openingBalanceType   String            @default("RECEIVABLE") @map("opening_balance_type") // RECEIVABLE, ADVANCE
  openingBalanceDate   DateTime?         @map("opening_balance_date")
  creditLimit          Float             @default(0.0) @map("credit_limit")
  creditPeriodDays     Int               @default(0) @map("credit_period_days")
  notes                String?
  currentBalance       Float             @default(0.0) @map("current_balance")
  isActive             Boolean           @default(true) @map("is_active")
  createdBy            String?           @map("created_by")
  updatedBy            String?           @map("updated_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoices        SalesInvoice[]
  salesPayments        SalesPayment[]
  ledger               CustomerLedger[]
  salesReturns         SalesReturn[]

  @@unique([companyId, customerCode])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, isActive])
  @@map("customers")
}

// 16. Suppliers
model Supplier {
  id                 String           @id @default(uuid())
  companyId          String           @map("company_id")
  supplierCode       String           @default("") @map("supplier_code")
  name               String
  contactPerson      String?          @map("contact_person")
  phone              String?
  alternatePhone     String?          @map("alternate_phone")
  email              String?
  website            String?
  addressLine1       String?          @map("address_line_1")
  addressLine2       String?          @map("address_line_2")
  city               String?
  state              String?
  pinCode            String?          @map("pin_code")
  country            String           @default("India")
  gstin              String?
  pan                String?
  registrationType   String           @default("UNREGISTERED") @map("registration_type") // REGULAR, COMPOSITION, UNREGISTERED, OVERSEAS
  openingBalance     Float            @default(0.0) @map("opening_balance")
  openingBalanceType String           @default("PAYABLE") @map("opening_balance_type") // PAYABLE, ADVANCE
  openingBalanceDate DateTime?        @map("opening_balance_date")
  creditLimit        Float            @default(0.0) @map("credit_limit")
  creditPeriodDays   Int              @default(0) @map("credit_period_days")
  notes              String?
  currentBalance     Float            @default(0.0) @map("current_balance")
  isActive           Boolean          @default(true) @map("is_active")
  createdBy          String?          @map("created_by")
  updatedBy          String?          @map("updated_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases          Purchase[]
  payments           PaymentMade[]
  ledger             SupplierLedger[]
  purchaseReturns    PurchaseReturn[]

  @@unique([companyId, supplierCode])
  @@index([companyId, name])
  @@index([companyId, isActive])
  @@map("suppliers")
}

// 17. Sales Payments (Payments Received From Customers)
model SalesPayment {
  id              String       @id @default(uuid())
  companyId       String       @map("company_id")
  customerId      String?      @map("customer_id")
  salesInvoiceId  String?      @map("sales_invoice_id")
  paymentNumber   String       @map("payment_number")
  paymentDate     DateTime     @default(now()) @map("payment_date")
  amount          Float        @default(0.0)
  paymentMode     String       @default("CASH") @map("payment_mode") // CASH, UPI, BANK_TRANSFER, CHEQUE, CARD, OTHER
  referenceNo     String?      @map("reference_no")
  status          String       @default("POSTED") @map("status") // POSTED, REVERSED
  reversedAt      DateTime?    @map("reversed_at")
  reversedBy      String?      @map("reversed_by")
  reversalReason  String?      @map("reversal_reason")
  notes           String?
  createdBy       String?      @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesInvoice    SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)

  @@unique([companyId, paymentNumber])
  @@index([companyId, customerId])
  @@index([companyId, salesInvoiceId])
  @@index([companyId, paymentDate])
  @@map("sales_payments")
}

// 18. Payments Made (To Suppliers)
model PaymentMade {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  supplierId     String         @map("supplier_id")
  purchaseId     String?        @map("purchase_id")
  paymentNumber  String         @map("payment_number")
  paymentDate    DateTime       @default(now()) @map("payment_date")
  amount         Float          @default(0.0)
  paymentMode    String         @default("BANK_TRANSFER") @map("payment_mode") // CASH, UPI, BANK_TRANSFER, CHEQUE, CARD, OTHER
  referenceNo    String?        @map("reference_no")
  status         String         @default("POSTED") @map("status") // POSTED, REVERSED
  reversedAt     DateTime?      @map("reversed_at")
  reversedBy     String?        @map("reversed_by")
  reversalReason String?        @map("reversal_reason")
  notes          String?
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([companyId, paymentNumber])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseId])
  @@index([companyId, paymentDate])
  @@map("payments_made")
}

// 19. Customer Ledger
model CustomerLedger {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  customerId      String   @map("customer_id")
  entryDate       DateTime @default(now()) @map("entry_date")
  transactionType String   @map("transaction_type") // OPENING_BALANCE, SALE, PAYMENT, SALES_RETURN, PAYMENT_REVERSAL, ADJUSTMENT
  referenceType   String?  @map("reference_type")
  referenceId     String?  @map("reference_id")
  referenceNumber String?  @map("reference_number")
  debitAmount     Float    @default(0.0) @map("debit_amount")  // Increases receivable (sale, opening receivable)
  creditAmount    Float    @default(0.0) @map("credit_amount") // Decreases receivable (payment, return, advance)
  runningBalance  Float    @default(0.0) @map("running_balance")
  description     String?
  notes           String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId, entryDate])
  @@index([companyId, transactionType])
  @@map("customer_ledger")
}

// 20. Supplier Ledger
model SupplierLedger {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  supplierId      String   @map("supplier_id")
  entryDate       DateTime @default(now()) @map("entry_date")
  transactionType String   @map("transaction_type") // OPENING_BALANCE, PURCHASE, PAYMENT, PURCHASE_RETURN, PAYMENT_REVERSAL, ADJUSTMENT
  referenceType   String?  @map("reference_type") // PURCHASE, PAYMENT, RETURN, OPENING
  referenceId     String?  @map("reference_id")
  referenceNumber String?  @map("reference_number")
  debitAmount     Float    @default(0.0) @map("debit_amount") // Decreases payable (e.g. payments, purchase returns, advances)
  creditAmount    Float    @default(0.0) @map("credit_amount") // Increases payable (e.g. purchases, opening payable)
  runningBalance  Float    @default(0.0) @map("running_balance")
  description     String?
  notes           String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, supplierId, entryDate])
  @@index([companyId, transactionType])
  @@map("supplier_ledger")
}

// 21. Audit Logs
model AuditLog {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  userId      String?  @map("user_id")
  action      String   // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, USER_CREATED, etc.
  module      String   @default("SYSTEM") // USERS, COMPANY, SETTINGS, AUTH, etc.
  referenceId String?  @map("reference_id")
  oldValue    String?  @map("old_value") // JSON representation
  newValue    String?  @map("new_value") // JSON representation
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// 22. Roles
model Role {
  id           String           @id @default(uuid())
  name         String           @unique
  description  String?
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  users        User[]
  permissions  RolePermission[]

  @@map("roles")
}

// 23. Permissions
model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. products.create
  name            String
  description     String?
  module          String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// 24. Role Permissions (Join Table)
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// 25. Settings
model Setting {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  key       String
  value     String
  type      String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("settings")
}

// 26. Expense Categories
model ExpenseCategory {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("expense_categories")
}

// 27. Expenses
model Expense {
  id                     String               @id @default(uuid())
  companyId              String               @map("company_id")
  expenseNumber          String               @map("expense_number")
  categoryId             String               @map("category_id")
  categoryNameSnapshot   String               @default("") @map("category_name_snapshot")
  expenseDate            DateTime             @default(now()) @map("expense_date")
  description            String
  payee                  String?
  amount                 Float                @default(0.0)
  paymentMethod          String               @default("CASH") @map("payment_method") // CASH, UPI, BANK_TRANSFER, CARD, CHEQUE, OTHER
  paymentAccountId       String?              @map("payment_account_id")
  cashRegisterSessionId  String?              @map("cash_register_session_id")
  referenceNumber        String?              @map("reference_number")
  receiptReference       String?              @map("receipt_reference")
  notes                  String?
  status                 String               @default("DRAFT") @map("status") // DRAFT, POSTED, CANCELLED
  createdBy              String?              @map("created_by")
  updatedBy              String?              @map("updated_by")
  postedBy               String?              @map("posted_by")
  postedAt               DateTime?            @map("posted_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category               ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cashRegisterSession    CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)
  cashMovements          CashMovement[]

  @@unique([companyId, expenseNumber])
  @@index([companyId, categoryId])
  @@index([companyId, expenseDate])
  @@index([companyId, status])
  @@map("expenses")
}

// 28. Cash Registers
model CashRegister {
  id           String                @id @default(uuid())
  companyId    String                @map("company_id")
  registerCode String                @map("register_code") // REG-MAIN
  name         String
  locationId   String?               @map("location_id")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     CashRegisterSession[]
  closings     DayEndClosing[]

  @@unique([companyId, registerCode])
  @@index([companyId, isActive])
  @@map("cash_registers")
}

// 29. Cash Register Sessions
model CashRegisterSession {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  cashRegisterId String          @map("cash_register_id")
  sessionNumber  String          @map("session_number") // SES-000001
  openedBy       String?         @map("opened_by")
  openedAt       DateTime        @default(now()) @map("opened_at")
  openingCash    Float           @default(0.0) @map("opening_cash")
  expectedCash   Float           @default(0.0) @map("expected_cash")
  countedCash    Float?          @map("counted_cash")
  cashDifference Float?          @map("cash_difference")
  status         String          @default("OPEN") @map("status") // OPEN, CLOSED
  closedBy       String?         @map("closed_by")
  closedAt       DateTime?       @map("closed_at")
  closingNotes   String?         @map("closing_notes")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegister   CashRegister    @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  movements      CashMovement[]
  expenses       Expense[]
  closings       DayEndClosing[]

  @@unique([companyId, sessionNumber])
  @@index([companyId, cashRegisterId, status])
  @@map("cash_register_sessions")
}

// 30. Cash Movements
model CashMovement {
  id                    String              @id @default(uuid())
  companyId             String              @map("company_id")
  cashRegisterId        String              @map("cash_register_id")
  cashRegisterSessionId String              @map("cash_register_session_id")
  movementNumber        String              @map("movement_number") // MOV-000001
  movementType          String              @map("movement_type") // OPENING_CASH, CASH_SALE, CUSTOMER_PAYMENT, CASH_IN, CASH_WITHDRAWAL, CASH_EXPENSE, SUPPLIER_CASH_PAYMENT, CASH_REFUND, CASH_OUT, CASH_DEPOSIT, CASH_ADJUSTMENT
  amount                Float               @default(0.0)
  movementDate          DateTime            @default(now()) @map("movement_date")
  referenceType         String?             @map("reference_type") // SALE, PAYMENT, EXPENSE, RETURN, MANUAL, OPENING
  referenceId           String?             @map("reference_id")
  referenceNumber       String?             @map("reference_number")
  description           String?
  expenseId             String?             @map("expense_id")
  createdBy             String?             @map("created_by")
  createdAt             DateTime            @default(now()) @map("created_at")

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegisterSession   CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id], onDelete: Cascade)
  expense               Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([companyId, movementNumber])
  @@index([companyId, cashRegisterSessionId, movementDate])
  @@index([companyId, movementType])
  @@map("cash_movements")
}

// 31. Day-End Closings
model DayEndClosing {
  id                     String              @id @default(uuid())
  companyId              String              @map("company_id")
  cashRegisterId         String              @map("cash_register_id")
  cashRegisterSessionId  String              @map("cash_register_session_id")
  closingNumber          String              @map("closing_number") // CLS-000001
  businessDate           DateTime            @default(now()) @map("business_date")
  openingCash            Float               @default(0.0) @map("opening_cash")
  cashSales              Float               @default(0.0) @map("cash_sales")
  customerCashReceipts   Float               @default(0.0) @map("customer_cash_receipts")
  supplierCashPayments   Float               @default(0.0) @map("supplier_cash_payments")
  cashExpenses           Float               @default(0.0) @map("cash_expenses")
  cashRefunds            Float               @default(0.0) @map("cash_refunds")
  cashIn                 Float               @default(0.0) @map("cash_in")
  cashOut                Float               @default(0.0) @map("cash_out")
  cashDeposits           Float               @default(0.0) @map("cash_deposits")
  cashWithdrawals        Float               @default(0.0) @map("cash_withdrawals")
  expectedCash           Float               @default(0.0) @map("expected_cash")
  countedCash            Float               @default(0.0) @map("counted_cash")
  cashDifference         Float               @default(0.0) @map("cash_difference")
  nonCashSales           Float               @default(0.0) @map("non_cash_sales")
  nonCashReceipts        Float               @default(0.0) @map("non_cash_receipts")
  nonCashExpenses        Float               @default(0.0) @map("non_cash_expenses")
  notes                  String?
  status                 String              @default("CLOSED") @map("status")
  closedBy               String?             @map("closed_by")
  closedAt               DateTime            @default(now()) @map("closed_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashRegister           CashRegister        @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  cashRegisterSession    CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id], onDelete: Restrict)

  @@unique([companyId, closingNumber])
  @@index([companyId, cashRegisterId, businessDate])
  @@map("day_end_closings")
}

// 41. Licenses (Step 10: Product Licensing, Activation & Edition Management)
model License {
  id                 String    @id @default(uuid())
  licenseId          String    @unique @map("license_id")
  licensePayload     String    @map("license_payload") // JSON canonical payload
  signature          String    @map("signature") // Base64
  signatureAlgorithm String    @default("RSA-SHA256") @map("signature_algorithm")
  edition            String    @default("SOLO") @map("edition")
  licenseType        String    @default("PERPETUAL") @map("license_type")
  activationStatus   String    @default("VALID") @map("activation_status")
  customerName       String    @map("customer_name")
  installationId     String?   @map("installation_id")
  issuedAt           DateTime  @map("issued_at")
  validFrom          DateTime  @map("valid_from")
  expiresAt          DateTime? @map("expires_at")
  lastValidatedAt    DateTime  @default(now()) @map("last_validated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([licenseId])
  @@index([activationStatus])
  @@map("licenses")
}


