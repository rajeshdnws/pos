{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@rs-inventory/types": ["../types/src/index.ts"],
      "@rs-inventory/database": ["./src/index.ts"],
      "@rs-inventory/business": ["../business/src/index.ts"],
      "@rs-inventory/printing": ["../printing/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
