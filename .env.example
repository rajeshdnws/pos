# RS Inventory - Environment Configuration Example

# Application Metadata
APP_NAME="RS Inventory"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Custom Paths (Optional: If omitted, defaults to %APPDATA%/RS Inventory/)
# DATABASE_PATH="C:/Users/username/AppData/Roaming/RS Inventory/database/rs_inventory.db"
# BACKUP_PATH="C:/Users/username/AppData/Roaming/RS Inventory/backups"
# LOG_PATH="C:/Users/username/AppData/Roaming/RS Inventory/logs"
# EXPORT_PATH="C:/Users/username/AppData/Roaming/RS Inventory/exports"

# Prisma CLI connection fallback URL
DATABASE_URL="file:./dev-data/database/rs_inventory.db"

# Logging Level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL="DEBUG"

# Electron Dev Server URL (used during npm run dev)
VITE_DEV_SERVER_URL="http://localhost:5173"
