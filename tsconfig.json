{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@rs-inventory/types": ["packages/types/src/index.ts"],
      "@rs-inventory/database": ["packages/database/src/index.ts"],
      "@rs-inventory/business": ["packages/business/src/index.ts"],
      "@rs-inventory/printing": ["packages/printing/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "desktop/renderer", "release", "backups", "logs", "dev-data"]
}
